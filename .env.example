# TR3S & CO. — variables de entorno
# Copia este archivo a .env.local (desarrollo) o configúralas en Vercel (producción).
# NUNCA subas .env.local al repositorio. Las variables sin NEXT_PUBLIC_ jamás llegan al navegador.

# URL pública del sitio (sin / final). Se usa en enlaces, redirecciones de pago y SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
# Sin estas variables la tienda muestra el catálogo vacío ("catálogo en preparación") y no permite comprar.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo servidor (webhooks, confirmación de pagos, gestión de roles).
SUPABASE_SERVICE_ROLE_KEY=

# --- Pasarelas de pago ---
# Una pasarela solo aparece en el checkout si (1) está activada en /admin/settings y (2) sus
# variables están completas. Todas las llaves secretas viven SOLO en el servidor.
# Webhooks: https://TU-DOMINIO/api/webhooks/wompi  y  https://TU-DOMINIO/api/webhooks/mercadopago

# Wompi (comercios.wompi.co → Desarrolladores). Usa primero las llaves de PRUEBAS.
WOMPI_PUBLIC_KEY=                # pub_test_... → pub_prod_...  (también se acepta NEXT_PUBLIC_WOMPI_PUBLIC_KEY)
WOMPI_INTEGRITY_SECRET=          # test_integrity_... → prod_integrity_...
WOMPI_EVENTS_SECRET=             # test_events_... → prod_events_...
WOMPI_ENVIRONMENT=sandbox        # sandbox | production (debe coincidir con el prefijo de la llave; alias: WOMPI_ENV)

# Mercado Pago Checkout Pro (mercadopago.com.co/developers → Tus integraciones).
MERCADOPAGO_ACCESS_TOKEN=        # Access token de PRUEBA y luego el de producción
MERCADOPAGO_WEBHOOK_SECRET=      # "Clave secreta" de Webhooks (Tus integraciones → Webhooks)
MERCADOPAGO_ENVIRONMENT=sandbox  # sandbox | production (solo informativo en el panel)

# PayU Latam — PREPARADO, NO ACTIVO. Puedes dejarlas vacías; el panel no permite activarlo aún.
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_ENVIRONMENT=sandbox

# --- WhatsApp ---
# Opcional: el número se configura en /admin/settings. Esta variable solo es respaldo.
# Formato internacional sin + ni espacios, ej: 573001234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analítica (solo se carga si el visitante acepta cookies) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Solo desarrollo local ---
# Catálogo de DEMOSTRACIÓN (productos ficticios, no comprables). Solo funciona SIN Supabase.
# Nunca lo actives en Vercel.
NEXT_PUBLIC_DEMO_CATALOG=
